#!/usr/bin/env python3
"""Rewrite agent shell sudo → claude-sudo-run so the pill shows the real argv.

Used by:
  - Claude Code: PreToolUse Bash (~/.claude/settings.json)
  - Cursor:      preToolUse Shell (~/.cursor/hooks.json)

`sudo -A` askpass does not get SUDO_COMMAND (empty); only a wrapper that
knows argv can show the true command in the dialog.
"""
from __future__ import annotations

import json
import re
import sys

HELPER = "/home/ringdal/.Scripts/claude-sudo-run"


# Only where a command can actually START: string start, after a separator,
# or on a fresh line. Matching after *any* whitespace was wrong — it also hit
# the word inside heredoc bodies and quoted strings, so writing a file that
# merely mentioned sudo rewrote the prose, and a call to the shell's own sudo
# target silently became a call to something that does not exist. Both cost an
# evening.
#
# The backtick used to be in this class too, for legacy command substitution.
# That was the same bug wearing a different hat: a backtick immediately before
# the word is far more often a markdown code span than a subshell, so every
# note written ABOUT this system got rewritten while it was being written —
# including the line in AGENTS.md that documents it. Backtick substitution is
# obsolete anyway; $() is what anything written today uses, and it is covered
# by the "(" branch.
#
# Trade-off: `time sudo x` and `env A=1 sudo x` are no longer rewritten. They
# then hit the terminal without an askpass and fail loudly, which is the safe
# way to be wrong. Still open: a heredoc line that begins with sudo.
COMMAND_POSITION = r"(^|[;|&(\n]\s*)sudo\b"


def rewrite_command(command: str) -> str | None:
    if HELPER in command:
        return None
    # Bare `sudo` only — leave `/usr/bin/sudo` inside python strings alone.
    if not re.search(COMMAND_POSITION, command):
        return None

    def repl(match: re.Match[str]) -> str:
        return f"{match.group(1)}{HELPER}"

    rewritten = re.sub(COMMAND_POSITION, repl, command)
    # Sudos egne adgangskode-flag skal væk. Wrapperen tager argv som en ren
    # kommando, så et flag der bliver stående, bliver læst som PROGRAMNAVNET:
    # `sudo -n true` endte som "sudo: -n: command not found", efter at Filip
    # havde lagt fingeren på læseren. De her flag handler alle sammen om,
    # hvordan adgangskoden skaffes — og det er præcis det, porten har overtaget,
    # så der er ingenting at bevare.
    rewritten = re.sub(
        rf"({re.escape(HELPER)})"
        r"(?:\s+(?:-A|--askpass|-k|--reset-timestamp"
        r"|-n|--non-interactive|-S|--stdin))+",
        r"\1",
        rewritten,
    )
    if rewritten == command:
        return None
    return rewritten


def main() -> int:
    raw = sys.stdin.buffer.read()
    while raw.startswith(b"\xef\xbb\xbf"):
        raw = raw[3:]
    try:
        event = json.loads(raw.decode("utf-8") or "{}")
    except json.JSONDecodeError:
        return 0

    tool_input = event.get("tool_input") or event.get("toolInput") or {}
    if not isinstance(tool_input, dict):
        tool_input = {}

    command = tool_input.get("command")
    if not isinstance(command, str) or not command:
        command = event.get("command")
    if not isinstance(command, str) or not command:
        return 0

    new_cmd = rewrite_command(command)
    if new_cmd is None:
        return 0

    updated = dict(tool_input)
    updated["command"] = new_cmd

    # Claude Code Bash hook
    if event.get("hook_event_name") == "PreToolUse" or event.get("tool_name") == "Bash":
        json.dump(
            {
                "hookSpecificOutput": {
                    "hookEventName": "PreToolUse",
                    "permissionDecision": "allow",
                    "updatedInput": updated,
                }
            },
            sys.stdout,
        )
        return 0

    # Cursor preToolUse (Shell) / flat beforeShellExecution
    json.dump(
        {
            "continue": True,
            "permission": "allow",
            "updated_input": updated,
        },
        sys.stdout,
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
