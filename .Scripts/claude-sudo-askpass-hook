#!/usr/bin/env python3
"""Rewrite agent shell sudo → claude-sudo-run so zenity shows the real argv.

Used by:
  - Claude Code: PreToolUse Bash (~/.claude/settings.json)
  - Cursor:      preToolUse Shell (~/.cursor/hooks.json)

`sudo -A` askpass does not get SUDO_COMMAND (empty); only a wrapper that
knows argv can show the true command in the dialog.
"""
from __future__ import annotations

import json
import re
import sys

HELPER = "/home/ringdal/.Scripts/claude-sudo-run"


def rewrite_command(command: str) -> str | None:
    if HELPER in command:
        return None
    # Bare `sudo` only — leave `/usr/bin/sudo` inside python strings alone.
    if not re.search(r"(^|[\s;|&`(])sudo(\s|$)", command):
        return None

    def repl(match: re.Match[str]) -> str:
        return f"{match.group(1)}{HELPER}"

    rewritten = re.sub(r"(^|[\s;|&`(])sudo\b", repl, command)
    rewritten = re.sub(
        rf"({re.escape(HELPER)})(?:\s+(?:-A|--askpass|-k|--reset-timestamp))+",
        r"\1",
        rewritten,
    )
    if rewritten == command:
        return None
    return rewritten


def main() -> int:
    raw = sys.stdin.buffer.read()
    while raw.startswith(b"\xef\xbb\xbf"):
        raw = raw[3:]
    try:
        event = json.loads(raw.decode("utf-8") or "{}")
    except json.JSONDecodeError:
        return 0

    tool_input = event.get("tool_input") or event.get("toolInput") or {}
    if not isinstance(tool_input, dict):
        tool_input = {}

    command = tool_input.get("command")
    if not isinstance(command, str) or not command:
        command = event.get("command")
    if not isinstance(command, str) or not command:
        return 0

    new_cmd = rewrite_command(command)
    if new_cmd is None:
        return 0

    updated = dict(tool_input)
    updated["command"] = new_cmd

    # Claude Code Bash hook
    if event.get("hook_event_name") == "PreToolUse" or event.get("tool_name") == "Bash":
        json.dump(
            {
                "hookSpecificOutput": {
                    "hookEventName": "PreToolUse",
                    "permissionDecision": "allow",
                    "updatedInput": updated,
                }
            },
            sys.stdout,
        )
        return 0

    # Cursor preToolUse (Shell) / flat beforeShellExecution
    json.dump(
        {
            "continue": True,
            "permission": "allow",
            "updated_input": updated,
        },
        sys.stdout,
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
