#!/usr/bin/env bash
# Write hyprwhspr Mic-OSD theme from current pywal palette.
# Matches rice: color0 bg (translucent), color4 border/bars, Terminus-era accents.

set -euo pipefail

colors_sh="${XDG_CACHE_HOME:-$HOME/.cache}/wal/colors.sh"
out_dir="${XDG_CONFIG_HOME:-$HOME/.config}/hyprwhspr/theme"
out="$out_dir/mic-osd.css"

background="#050907"
foreground="#a4aba7"
color0="#050907"
color4="#c7755f"
color5="#6ba674"
color7="#a4aba7"

if [[ -f $colors_sh ]]; then
	# shellcheck disable=SC1090
	eval "$(grep -E '^(background|foreground|color[0-9]+)=' "$colors_sh")"
fi

bg="${color0:-$background}"
fg="${foreground:-$color7}"
accent="${color4}"
muted="${color5}"

# ~80% opaque like fuzzel/dunst
bg_a="${bg#\#}cc"

mkdir -p "$out_dir"
cat >"$out" <<EOF
/* Generated by hyprwhspr-theme-from-wal — do not edit by hand; re-run after chwal */
@define-color background-color #${bg_a};
@define-color border-color ${accent};
@define-color bar-color-left ${accent};
@define-color bar-color-right ${muted};
@define-color recording-dot #ff0000;
@define-color text-color ${fg};
@define-color paused-dot #ffaa00;
@define-color processing-dot #ffaa00;
@define-color error-dot #ff0000;
@define-color success-dot ${muted};
EOF

printf '%s\n' "Wrote $out"
