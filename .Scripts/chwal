#!/usr/bin/env bash

dir="$HOME/Pictures/favoritter"
: "$(< .cache/wal/wal)"
current="${_##*/}"

usage(){ printf '%s\n' "$1."\
	"chwal [-rl] [-f FILE] [-i FILE] [-w FILE] [-b backend]"\
	"-r: reload current" "-l: light theme"\
	"-f: add image to rotation"\
	"-i: apply image (wal + hyprland), no favorites"\
	"-w: wallpaper only (awww, no palette)"\
	"-b: wal backend (with -i/-f): wal|colorz|haishoku|colorthief"
	exit 1
}

next_fav(){
   get_next_fav || next="$dir/$current"
   backend="$(cat "${next%.*}.backend")"
	printf '%s\n' "LAST: $current" "NEXT: ${next##*/}" '' "FAVOTITES:" "${files[@]}"
	change_wal
}

get_next_fav(){
	[[ $r = "1" ]] && return 1

	get_files

	for ((i=0;i<=${#files[@]};i++));{
		[[ "${files[$i]}" = "$current" ]] || continue
		sel_next_or_first
	}
}

get_files(){
	for file in ${dir}/*; { [[ $file = *.backend ]] || files+=("${file##*/}"); }
	num_files="$((${#files[@]}-1))"
}

sel_next_or_first(){
	if [[ ${files[$i]} = ${files[$num_files]} ]]
	then next="$dir/${files[0]}"
	else next="$dir/${files[$((i+1))]}"; fi
}

change_wal(){
   wal -tqi "$next" ${l} --backend "$backend" -a 0
   cp "$next" "$HOME/.config/wall.png"

   if [[ -n "$WAYLAND_DISPLAY" || "$XDG_SESSION_TYPE" == "wayland" ]]; then
      apply_hyprland
   else
      $CONFIG &>/dev/null
   fi
}

# awww afloeste hyprpaper 2026-08-28. Forskellen der betyder noget her:
# hyprpaper laeste sin baggrund fra en configfil, saa skiftet skulle skrives to
# steder — nu og til naeste opstart. awww holder tilstanden i daemonen og
# husker selv det sidste billede, saa der er kun ét kald. Gendannelsen efter en
# genstart ligger i ~/.Scripts/wallpaper-start.
#
# --resize crop svarer til hyprpapers fit_mode = cover.
# Overgangen er blød med vilje: et baggrundsskift er ikke en besked, og et hårdt
# klip river blikket til sig uden grund.
apply_wallpaper(){
   awww img "$next" \
      --resize crop \
      -t fade --transition-duration 1.2 --transition-fps 60 &>/dev/null
}

set_wallpaper_only(){
	[[ -f "$1" ]] || usage "Not a valid path"
	next="$1"
	cp "$next" "$HOME/.config/wall.png"
	apply_wallpaper
}

apply_hyprland(){
   apply_wallpaper
   # borders from wal (Lua config)
   # shellcheck disable=SC1090
   source "$HOME/.cache/wal/colors.sh"
   cat > "$HOME/.config/hypr/colors.lua" <<EOF
-- Seeded from ~/.cache/wal/colors.sh (color0 inactive, color4 active)

return {
    background      = "rgb(${background#\#})",
    foreground      = "rgb(${foreground#\#})",
    color0          = "rgb(${color0#\#})",
    color4          = "rgb(${color4#\#})",
    color7          = "rgb(${color7#\#})",
    color8          = "rgb(${color8#\#})",
    active_border   = "rgb(${color4#\#})",
    inactive_border = "rgb(${color0#\#})",
}
EOF
   hyprctl reload &>/dev/null
   # quickshell laeser ~/.cache/wal/colors.json; sig til med det samme
   qs -c ringdal ipc call theme reload &>/dev/null || true
   # waybar picks up ~/.cache/wal/colors-waybar.css (fallback-baren)
   pkill -USR2 waybar 2>/dev/null || true
   # hyprwhspr Mic-OSD theme (if present)
   if [[ -x $HOME/.Scripts/hyprwhspr-theme-from-wal ]]; then
      "$HOME/.Scripts/hyprwhspr-theme-from-wal" &>/dev/null || true
   fi
}

add_new_fav(){
	[[ -f "$1" ]] || usage "Not a valid path"
	name="${1##*/}"
	[[ -f $dir/$name ]] && { printf '%s\n' "already in favorites"; exit; }

	if [[ -z "${backend:-}" ]]; then
		prompt_user_backend
		case_backend
	fi

	save_new_fav "$1"
	next="$dir/$name"
	change_wal
}

prompt_user_backend(){
   read -rp $'\e[1;34m'"backends:"$'\n\e[0;34m'"w: wal"$'\n'\
"c: colorz"$'\n'"h: haishoku"$'\n'"t: colorthief"\
$'\n\e[1;32m'"choose > "$'\e[0m' b
}

case_backend(){
   case $b in
		w) backend="wal" ;;
		c) backend="colorz" ;;
      h) backend="haishoku" ;;
		t) backend="colorthief" ;;
		*) exit 1
   esac
}

save_new_fav(){
	printf '%s' "$backend" > "$dir/${name%.*}.backend"
   cp "$1" "$dir/$name"
}

main(){
	local fav="" img_apply="" wall_only=""
	while getopts "rlf:i:w:b:" o; do case $o in
		f) fav=$OPTARG ;;
		i) img_apply=$OPTARG ;;
		w) wall_only=$OPTARG ;;
		b) backend=$OPTARG ;;
		l) l="-l" ;;
		r) r="1" ;;
		*) usage; exit 1
	esac
	done
	if [[ -n $wall_only ]]; then
		set_wallpaper_only "$wall_only"
		exit 0
	fi
	if [[ -n $fav ]]; then
		add_new_fav "$fav"
		exit 0
	fi
	if [[ -n $img_apply ]]; then
		[[ -f $img_apply ]] || usage "Not a valid path"
		next=$img_apply
		[[ -n ${backend:-} ]] || backend=wal
		change_wal
		exit 0
	fi
	next_fav
}

main "$@"
