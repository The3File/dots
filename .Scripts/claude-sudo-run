#!/usr/bin/env bash
# Privileged-command gate for agents (Claude Code + Cursor).
#
#   1) Pillen viser den PRAECISE argv, der er ved at koere som root, og bliver
#      staaende. Ingen tid loeber. Ingen laeser er taendt.
#   2) Filip trykker paa stroemknappen: "jeg er her". Trykket giver ingenting
#      -- det aabner kun fingerlaeseren, mens han staar der.
#   3) Fingeren er svaret. PAM tager den paa en rigtig PTY, pillen kvitterer
#      paa skaermen, og kommandoen koerer.
#
# Hvorfor trin 2 findes: fingeraftryk kan ikke vente. PAM aabner laeseren i faa
# sekunder og giver op, og staar han ude i koekkenet, var spoergsmaalet doedt,
# foer han naaede tilbage. Trykket er ikke det gamle ja/nej-vindue tilbage --
# det giver ikke adgang til noget, og et tryk ved en fejl koster ingenting.
# Laeseren sidder I stroemknappen paa den her maskine, saa det er ét sted at
# roere: han trykker, og fingeren ligger allerede hvor den skal.
#
# Der er INGEN zenity-fallback laengere. Kan pillen ikke spoerge, koerer
# kommandoen ikke. Et root-spoergsmaal, der pludselig staar et andet sted end
# der hvor han kigger, er det man laerer at klikke vaek uden at laese -- og
# fallbacken traadte i praksis til, hver gang et haengende spoergsmaal havde
# spaerret pillen, altsaa naar den var mest forkert. Spoergsmaalene har numre
# nu, og et nyt afloeser altid et gammelt, saa den slags kan ikke hobe sig op.
#
# Usage: claude-sudo-run <command> [args...]
# Do not call bare `sudo -A` from agents -- askpass never receives the command.

set -uo pipefail

SCRIPTS=/home/ringdal/.Scripts

if [[ $# -eq 0 ]]; then
	echo "claude-sudo-run: command required" >&2
	exit 1
fi

# Faithful shell-escaped form of the argv that will be exec'd after --.
display=$(printf '%q ' "$@")
display=${display%% }

if ! nr=$("$SCRIPTS/pill-sudo" rejs "$display"); then
	echo "claude-sudo-run: pillen kunne ikke spoerge om root-adgang -- koer kommandoen selv i en terminal" >&2
	exit 1
fi

# Ryd altid spoergsmaalet vaek igen, ogsaa hvis vi bliver draebt undervejs.
# Uden det blev pillen staaende med et spoergsmaal, ingen ventede paa -- og det
# var praecis dét, der sendte de naeste kommandoer over i zenity. `afbryd`
# rydder kun sit eget nummer, saa en sen oprydning ikke kan taske et
# spoergsmaal, Filip lige har faaet stillet.
oprydning() { "$SCRIPTS/pill-sudo" afbryd "$nr" 2>/dev/null; }
trap 'oprydning; exit 130' INT TERM HUP
trap oprydning EXIT

# Vent paa ham. Ingen tidsgraense her: det er hele grunden til trinnet.
svar=$("$SCRIPTS/pill-sudo" vent "$nr") || {
	echo "claude-sudo-run: pillen svarede ikke" >&2
	exit 1
}
if [[ $svar != klar ]]; then
	echo "claude-sudo-run: root-adgang blev ikke givet ($svar)" >&2
	exit 1
fi

# Password askpass must show the same argv (sudo does not set SUDO_COMMAND for
# askpass -- verified empty under -A).
export SUDO_DISPLAY_CMD=$display
export SUDO_ASKPASS=$SCRIPTS/pill-askpass
export SUDO_PILL=1
export SUDO_PILL_NR=$nr

# The command runs in the background so the watchdog below can still reach it.
# Gotcha with teeth: a background job in a non-interactive shell gets its stdin
# pointed at /dev/null, before anything else gets a say. `echo x | sudo tee f`
# then wrote an empty file, and the blame landed on sudo for two rounds. An
# explicit redirection is what overrides it, so keep a copy of the real stdin
# and hand it over by name.
exec 3<&0
"$SCRIPTS/sudo-pty" "$@" <&3 &
kok=$!
exec 3<&-

# Fortryder han, mens laeseren staar aaben, skal kommandoen doe med det samme --
# ellers var den eneste vej ud at sidde og vente paa, at PAM gav op.
#
# Vagten faar ALDRIG adgangskoden at se: `vagt` svarer kun venter/nej/slut. Og
# den holder op ved "slut" -- er fingeren taget imod, koerer kommandoen nu, og
# saa maa et nyt spoergsmaal fra en anden agent ikke kunne draebe den.
(
	while kill -0 "$kok" 2>/dev/null; do
		case $("$SCRIPTS/pill-sudo" vagt "$nr" 2>/dev/null) in
		nej) kill "$kok" 2>/dev/null; break ;;
		venter) ;;
		*) break ;;
		esac
		sleep 0.2
	done
) &
vagt=$!

wait "$kok"
status=$?
kill "$vagt" 2>/dev/null
exit "$status"
