#!/usr/bin/env bash
# Privileged-command gate for agents (Claude Code + Cursor).
#
#   1) The pill shows the EXACT argv that is about to run as root, and asks for
#      a fingerprint.
#   2) The finger IS the answer. PAM takes it on a real PTY, the pill confirms
#      it on screen, and the command runs.
#
# There used to be a yes/no dialog first and a fingerprint after. That is the
# same question twice, and the first one is the one you learn to click away
# without reading. Now there is one gesture, and it is the one that cannot be
# given by accident.
#
# Usage: claude-sudo-run <command> [args...]
# Do not call bare `sudo -A` from agents — askpass never receives the command.
#
# Zenity is kept as the fallback, on purpose and for the same reason waybar is:
# the question must survive the shell being down. pill-sudo exits 2 when it
# cannot ask, and everything below then works exactly as it did before.

set -uo pipefail

SCRIPTS=/home/ringdal/.Scripts

if [[ $# -eq 0 ]]; then
	echo "claude-sudo-run: command required" >&2
	exit 1
fi

# Faithful shell-escaped form of the argv that will be exec'd after --.
display=$(printf '%q ' "$@")
display=${display%% }

if "$SCRIPTS/pill-sudo" rejs finger "$display"; then
	i_pillen=1
else
	i_pillen=0
	if ! zenity-rice --question --title="sudo" --width=640 \
		--ok-label="Tillad" --cancel-label="Annuller" \
		--text="Tillad denne sudo-kommando?

${display}

Tillad → fingeraftryk (timeout → adgangskode)." 2>/dev/null; then
		exit 1
	fi
fi

# Password askpass fallback must show the same argv (sudo does not set
# SUDO_COMMAND for askpass — verified empty under -A).
export SUDO_DISPLAY_CMD=$display
if ((i_pillen)); then
	export SUDO_ASKPASS=$SCRIPTS/pill-askpass
	export SUDO_PILL=1
else
	export SUDO_ASKPASS=$SCRIPTS/zenity-askpass
fi

# The command runs in the background so the watchdog below can still reach it.
# Gotcha with teeth: a background job in a non-interactive shell gets its stdin
# pointed at /dev/null, before anything else gets a say. `echo x | sudo tee f`
# then wrote an empty file, and the blame landed on sudo for two rounds. An
# explicit redirection is what overrides it, so keep a copy of the real stdin
# and hand it over by name.
exec 3<&0
"$SCRIPTS/sudo-pty" "$@" <&3 &
kok=$!
exec 3<&-

# Dismissing the question is a refusal — otherwise the only way out would be to
# sit and wait for PAM to give up. Only an explicit "nej" kills: once the finger
# is accepted the question is cleared, and a cleared question answers
# "ingenting", which must never be mistaken for a refusal of a command that is
# already running.
if ((i_pillen)); then
	(
		while kill -0 "$kok" 2>/dev/null; do
			[[ $("$SCRIPTS/pill-sudo" afvist 2>/dev/null) == ja ]] && {
				kill "$kok" 2>/dev/null
				break
			}
			sleep 0.2
		done
	) &
	vagt=$!
fi

wait "$kok"
status=$?
[[ -n ${vagt:-} ]] && kill "$vagt" 2>/dev/null
"$SCRIPTS/pill-sudo" afbryd 2>/dev/null
exit "$status"
