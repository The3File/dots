#!/usr/bin/env bash
# Hold maskinen vågen — låget må lukkes, og skærmen bliver tændt.
#
# Usage: koffein {on|off|toggle|status|signal|<varighed>}
#   koffein            → tænd (samme som "on")
#   koffein 2h         → tænd, sluk selv om 2 timer (2h / 45m / 30s / 90 = minutter)
#   koffein off        → slut
#   koffein status     → menneske-linje i terminal, JSON når stdout ikke er tty
#
# Låsen dækker både logind's låg-håndtering (HandleLidSwitch=suspend på batteri)
# og idle, som hypridle respekterer (ignore_systemd_inhibit = false) — så
# skærmen bliver tændt, så længe koffein er tændt. Én tilstand, intet flag.
#
# Bevidst dvale (bye-menuen, systemctl suspend) blokeres IKKE med vilje.
# Låsen lever præcis så længe processen lever, så "off" = dræb processen.
# Polkit tillader begge låse uden kodeord for en aktiv session — ingen sudo.
#
# Waybar: custom/koffein (signal RTMIN+5). Klik → sluk. Skjult når den er slukket.
# Genvej: Super+Alt+Shift+K → koffein toggle (hyprland.lua).

set -euo pipefail

RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
STATE="$RUNTIME/koffein.state"

PID=""
UNTIL=""

die() {
	printf 'koffein: %s\n' "$1" >&2
	exit 1
}

# Lever låsen? Sætter PID/UNTIL fra state-filen.
running() {
	PID=""
	UNTIL=""
	[[ -r $STATE ]] || return 1
	# shellcheck disable=SC1090
	source "$STATE"
	[[ -n ${PID:-} ]] || return 1
	if { tr '\0' ' ' <"/proc/$PID/cmdline" | grep -q systemd-inhibit; } 2>/dev/null; then
		return 0
	fi
	rm -f "$STATE"
	return 1
}

signal_pillen() {
	qs -c ringdal ipc call koffein refresh &>/dev/null || true
}

# "2h" / "45m" / "30s" / "90" (bare tal = minutter) → sekunder
parse_duration() {
	local d=$1 n unit
	n=${d%[hmsHMS]}
	unit=${d#"$n"}
	[[ $n =~ ^[0-9]+$ ]] || return 1
	case "${unit,,}" in
	h) printf '%s' $((n * 3600)) ;;
	s) printf '%s' "$n" ;;
	m | '') printf '%s' $((n * 60)) ;;
	*) return 1 ;;
	esac
}

fmt_left() {
	local s=$1 h m
	((s < 0)) && s=0
	h=$((s / 3600))
	m=$(((s % 3600) / 60))
	if ((h > 0)); then
		printf '%dt%02dm' "$h" "$m"
	elif ((m > 0)); then
		printf '%dm' "$m"
	else
		printf '%ds' "$s"
	fi
}

stop() {
	if running; then
		pkill -P "$PID" 2>/dev/null || true
		kill "$PID" 2>/dev/null || true
	fi
	rm -f "$STATE"
	signal_pillen
}

start() {
	local secs=$1 until_ pid

	if [[ $secs == inf ]]; then
		until_=inf
	else
		until_=$(($(date +%s) + secs))
	fi

	# Skal startes fra den grafiske session (ikke som user-unit): polkit-reglen
	# for lid-låsen er "implicit any: no", så en sessionsløs proces kan nægtes.
	setsid systemd-inhibit --what='handle-lid-switch:idle' --who=koffein \
		--why='koffein: låget ignoreres, skærmen bliver tændt' --mode=block \
		sleep "${secs/inf/infinity}" </dev/null >/dev/null 2>&1 &
	pid=$!

	# setsid exec'er normalt direkte; forker den, er låsen barnets.
	if ! { tr '\0' ' ' <"/proc/$pid/cmdline" | grep -q systemd-inhibit; } 2>/dev/null; then
		local child
		child=$(pgrep -P "$pid" 2>/dev/null | head -1 || true)
		if [[ -n $child ]]; then
			pid=$child
		fi
	fi

	printf 'PID=%s\nUNTIL=%s\n' "$pid" "$until_" >"$STATE"
	signal_pillen
}

human_status() {
	if running; then
		local left=''
		if [[ $UNTIL != inf ]]; then
			left=" (slukker om $(fmt_left $((UNTIL - $(date +%s)))))"
		fi
		printf 'koffein: tændt — låget ignoreres, skærmen bliver tændt%s\n' "$left"
	else
		printf 'koffein: slukket\n'
	fi
}

json_status() {
	if running; then
		local text='koffein' tip left=''
		if [[ $UNTIL == inf ]]; then
			tip='Slukker først når du siger til.'
		else
			left=$(fmt_left $((UNTIL - $(date +%s))))
			text="$text $left"
			tip="Slukker om $left ($(date -d "@$UNTIL" +%H:%M))."
		fi
		tip="Låget ignoreres. Skærmen bliver tændt.\n$tip"
		printf '{"text":"%s","tooltip":"%s","class":"on"}\n' "$text" "$tip"
	else
		printf '{"text":"","tooltip":"","class":"off"}\n'
	fi
}

# Kun støj i terminalen, ikke når pillen kalder.
say_off() {
	if [[ -t 1 ]]; then
		printf 'koffein: slukket\n'
	fi
}

say_on() {
	if [[ -t 1 ]]; then
		human_status
	fi
}

main() {
	while [[ ${1:-} == -* ]]; do
		case $1 in
		-h | --help)
			sed -n '2,19p' "$0" | sed 's/^# \?//'
			exit 0
			;;
		*) die "ukendt flag: $1 (prøv -h)" ;;
		esac
		shift
	done

	local cmd=${1:-on} secs
	case "$cmd" in
	status)
		if [[ -t 1 ]]; then human_status; else json_status; fi
		;;
	signal)
		signal_pillen
		;;
	off)
		stop
		say_off
		;;
	toggle)
		if running; then
			stop
			say_off
		else
			start inf
			say_on
		fi
		;;
	on | *)
		if [[ $cmd == on ]]; then
			secs=inf
		else
			secs=$(parse_duration "$cmd") || die "forstod ikke '$cmd' (prøv on, off, status eller fx 2h)"
		fi
		# Erstat en kørende lås frem for at stable to.
		if running; then
			stop
		fi
		start "$secs"
		say_on
		;;
	esac
	return 0
}

main "$@"
