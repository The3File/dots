#!/usr/bin/env bash
# Claude Code hook: speak Notification / Stop when claude-speak is on.
# Usage: claude-speak-hook {notification|stop}   (JSON on stdin)
#
# Stop reads the <speak> block: last_assistant_message first (fresh final text),
# then falls back to scanning the current turn in the transcript. See hooks docs.

set -euo pipefail

flag="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/claude-speak.on"
[[ -f $flag ]] || exit 0

mode=${1:-}
[[ -n $mode ]] || exit 0

json=$(cat)
[[ -n $json ]] || exit 0

tts=/home/ringdal/.Scripts/claude-speak-tts

case $mode in
	notification)
		msg=$(printf '%s' "$json" | jq -r '.message // empty' 2>/dev/null || true)
		[[ -n $msg ]] || exit 0
		# Filip doesn't want the idle "waiting for your input" nudge read aloud.
		[[ ${msg,,} == *"waiting for your input"* ]] && exit 0
		"$tts" "$msg"
		;;
	stop)
		path=$(printf '%s' "$json" | jq -r '.transcript_path // empty' 2>/dev/null || true)
		# Fresh final message (correct turn; transcript can lag by one message)
		text=$(printf '%s' "$json" | jq -r '.last_assistant_message // empty' 2>/dev/null || true)
		if [[ -z $text && -n $path && -f $path ]]; then
			text=$(jq -rs 'map(select(.type=="assistant")) | last | (.message.content // []) | map(select(.type=="text") | .text) | join("\n")' "$path" 2>/dev/null || true)
		fi

		# Extract the <speak> block. Per the structure rule it's a CLOSING summary
		# at the END of the turn, so last_assistant_message usually has it. Safety
		# net: if the final text has no block, scan the whole current turn from the
		# transcript (assistant text after the last genuine user prompt) and take
		# the LAST block — so a block placed earlier is still found. (2026-08-09)
		extract_last_speak() { perl -0777 -ne '@m=/<speak>(.*?)<\/speak>/gis; print $m[-1] if @m' 2>/dev/null || true; }
		speak=$(printf '%s' "$text" | extract_last_speak)
		if [[ -z $speak && -n $path && -f $path ]]; then
			turn=$(jq -rs '
				(map(.type=="user" and ((.message.content // []) | if type=="array" then ((any(.[]; .type=="text")) and (all(.[]; .type!="tool_result"))) else true end)) | rindex(true)) as $u
				| (if $u == null then 0 else $u+1 end) as $start
				| .[$start:]
				| map(select(.type=="assistant") | (.message.content // []) | map(select(.type=="text") | .text) | join("\n"))
				| join("\n")
			' "$path" 2>/dev/null || true)
			speak=$(printf '%s' "$turn" | extract_last_speak)
		fi

		if [[ -n $speak ]]; then
			# Curated essence — raise cap well above the read-everything fallback so
			# a normal-length block is read in full, not cut off at 500 chars.
			CLAUDE_SPEAK_MAX_CHARS="${CLAUDE_SPEAK_MAX_CHARS:-4000}" "$tts" "$speak"
		elif [[ -n $text ]]; then
			"$tts" "$text"
		fi
		;;
	prompt)
		# UserPromptSubmit: flag confirmed on (top of script). stdout is injected
		# into the model context for this turn: updates during work + a closing
		# <speak> summary at the end. Keep in sync with the feedback_tts_mode memory.
		cat <<-'REMINDER'
		[TTS er slået til] Struktur: (1) Giv MANGE korte talte opdateringer LØBENDE mens du arbejder — kald ~/.Scripts/claude-speak-tts "kort linje" før/efter de fleste handlinger, ikke kun store milepæle. Filip vil kunne følge strømmen passivt uden selv at tjekke, så vær rundhåndet; linjerne afspilles i kø, så de taler ikke oven i hinanden. (2) AFSLUT svaret med en <speak>...</speak>-blok til allersidst: en OPSUMMERING i talt, naturligt dansk — hvad der skete + essensen + evt. spørgsmål (simpelt). Blokken læses op til sidst, så den skal være en AFSLUTNING, ALDRIG en indledende "nu går jeg i gang"-bemærkning. Ingen kode/stier/lister i blokken. Fuld teknisk tekst skrives normalt uden for blokken.
		REMINDER
		;;
	*)
		exit 0
		;;
esac
