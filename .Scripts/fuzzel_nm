#!/usr/bin/env bash
# NetworkManager WiFi / connection picker.
# Usage: fuzzel_nm [menu|list|ssids|up <name>|down <name>|connect <ssid> <pass>|delete <name>]
#
# menu (default) er den gamle fuzzel-menu og staar uroert -- den er fallback.
# De oevrige underkommandoer er den samme nmcli-logik uden menu, saa pillen
# (quickshell: services/Nm.qml) kan bruge praecis den samme kode i stedet for
# at faa sin egen halve udgave af det samme.

set -euo pipefail

conf_dir="${XDG_CONFIG_HOME:-$HOME/.config}/fuzzel"
mkdir -p "$conf_dir"

write_fuzzel_ini() {
	local color4="#5ca7a5" color5="#c3a170" color7="#c5c5c5" color8="#525353" prompt=${1:-nm: }
	if [[ -f $HOME/.cache/wal/colors.sh ]]; then
		# shellcheck disable=SC1090
		eval "$(grep -E '^color[0-9]+=' "$HOME/.cache/wal/colors.sh")"
	fi
	hex() {
		local c="${1#\#}"
		printf '%s%s' "$c" "${2:-ff}"
	}
	cat >"$conf_dir/fuzzel.ini" <<EOF
font=Terminus:size=14
dpi-aware=no
prompt="$prompt"
icons-enabled=no
layer=overlay
anchor=bottom-left
x-margin=24
y-margin=24
lines=12
width=48
horizontal-pad=20
vertical-pad=16
inner-pad=10
keyboard-focus=exclusive
exit-on-keyboard-focus-loss=no

[colors]
background=$(hex "#000000")
text=$(hex "$color7")
prompt=$(hex "$color5")
input=$(hex "$color7")
match=$(hex "$color4")
selection=$(hex "$color4")
selection-text=$(hex "#000000")
selection-match=$(hex "#000000")
border=$(hex "$color4")
counter=$(hex "$color8")

[border]
width=2
radius=0
selection-radius=0
EOF
}

pick() {
	local prompt=$1
	shift
	write_fuzzel_ini "$prompt"
	printf '%s\n' "$@" | /usr/bin/fuzzel --dmenu --prompt="$prompt" || true
}

active_con() {
	nmcli -t -f NAME c show --active 2>/dev/null | head -1 || true
}

list_cons() {
	# Loopback staar i NetworkManagers liste som enhver anden forbindelse,
	# men den er ikke noget man vaelger: den kan hverken slaas fra eller
	# slettes med mening. TYPE foerst, saa navnet faar resten af linjen --
	# et navn maa gerne indeholde kolon, en type maa ikke.
	nmcli -t -f TYPE,NAME c show 2>/dev/null |
		awk -F: '$1 != "loopback" { sub(/^[^:]*:/, ""); if ($0 != "") print }'
}

notify() {
	notify-send -a fuzzel_nm -t 2500 "nm" "$1" 2>/dev/null || true
}

new_wifi() {
	local ssid pass
	notify "scanning WiFi…"
	nmcli device wifi rescan >/dev/null 2>&1 || true
	sleep 1
	mapfile -t ssids < <(nmcli -t -f SSID d wifi list 2>/dev/null | sed '/^$/d' | awk '!seen[$0]++')
	[[ ${#ssids[@]} -gt 0 ]] || {
		notify "no networks found"
		return 1
	}
	ssid=$(pick 'wifi: ' "${ssids[@]}")
	[[ -n $ssid ]] || return 0
	write_fuzzel_ini 'pass: '
	pass=$(/usr/bin/fuzzel --dmenu --password --prompt='pass: ' </dev/null || true)
	[[ -n $pass ]] || return 0
	if nmcli device wifi connect "$ssid" password "$pass"; then
		notify "connected: $ssid"
	else
		notify "failed: $ssid"
	fi
}

delete_con() {
	local con
	mapfile -t cons < <(list_cons)
	[[ ${#cons[@]} -gt 0 ]] || return 0
	con=$(pick 'delete: ' "${cons[@]}")
	[[ -n $con ]] || return 0
	nmcli connection delete "$con" && notify "deleted: $con"
}

# --- ikke-interaktiv indgang (bruges af pillen) ------------------------------

active_cons() {
	nmcli -t -f NAME c show --active 2>/dev/null | sed '/^$/d'
}

# "*<TAB>navn" for aktive forbindelser, " <TAB>navn" for resten.
cmd_list() {
	local active c
	active=$(active_cons)
	while IFS= read -r c; do
		[[ -n $c ]] || continue
		if printf '%s\n' "$active" | grep -qxF "$c"; then
			printf '*\t%s\n' "$c"
		else
			printf ' \t%s\n' "$c"
		fi
	done < <(list_cons)
}

# "styrke<TAB>sikkerhed<TAB>ssid", staerkeste foerst.
cmd_ssids() {
	nmcli device wifi rescan >/dev/null 2>&1 || true
	sleep 2
	nmcli -t -f SIGNAL,SECURITY,SSID d wifi list 2>/dev/null |
		awk -F: 'NF >= 3 && $3 != "" {
			ssid = $3
			for (i = 4; i <= NF; i++) ssid = ssid ":" $i
			if (!seen[ssid]++) printf "%s\t%s\t%s\n", $1, $2, ssid
		}' | sort -rn
}

cmd_up() {
	nmcli connection up "$1" >/dev/null 2>&1 && notify "up: $1" || {
		notify "failed: $1"
		return 1
	}
}

cmd_down() {
	nmcli connection down "$1" >/dev/null 2>&1 && notify "down: $1" || {
		notify "failed: $1"
		return 1
	}
}

cmd_connect() {
	local ssid=$1 pass=${2:-} rc=0
	if [[ -n $pass ]]; then
		nmcli device wifi connect "$ssid" password "$pass" >/dev/null 2>&1 || rc=$?
	else
		nmcli device wifi connect "$ssid" >/dev/null 2>&1 || rc=$?
	fi
	if [[ $rc -eq 0 ]]; then
		notify "connected: $ssid"
	else
		notify "failed: $ssid"
		return 1
	fi
}

cmd_delete() {
	nmcli connection delete "$1" >/dev/null 2>&1 && notify "deleted: $1" || return 1
}

main() {
	local active choice name
	active=$(active_con)
	mapfile -t cons < <(list_cons)

	local lines=()
	local c
	for c in "${cons[@]}"; do
		if [[ -n $active && $c == "$active" ]]; then
			lines+=("* $c")
		else
			lines+=("  $c")
		fi
	done
	lines+=("  [+] new wifi")
	lines+=("  [-] delete")

	choice=$(pick 'nm: ' "${lines[@]}")
	[[ -n $choice ]] || exit 0
	choice=${choice#\* }
	choice=${choice#  }

	case "$choice" in
	'[+] new wifi')
		new_wifi
		;;
	'[-] delete')
		delete_con
		;;
	*)
		name=$choice
		if [[ -n $active && $name == "$active" ]]; then
			nmcli connection down "$name" && notify "down: $name"
		else
			nmcli connection up "$name" && notify "up: $name"
		fi
		;;
	esac
}

usage() {
	printf 'usage: %s [menu|list|ssids|up <name>|down <name>|connect <ssid> [pass]|delete <name>]\n' "${0##*/}" >&2
}

case "${1:-menu}" in
menu | '') main ;;
list) cmd_list ;;
ssids) cmd_ssids ;;
up)
	[[ -n ${2:-} ]] || { usage; exit 2; }
	cmd_up "$2"
	;;
down)
	[[ -n ${2:-} ]] || { usage; exit 2; }
	cmd_down "$2"
	;;
connect)
	[[ -n ${2:-} ]] || { usage; exit 2; }
	cmd_connect "$2" "${3:-}"
	;;
delete)
	[[ -n ${2:-} ]] || { usage; exit 2; }
	cmd_delete "$2"
	;;
*)
	usage
	exit 2
	;;
esac
