#!/usr/bin/env bash
# Shared TTS for Claude speak: Piper Danish when available, else espeak-ng.
# Usage: claude-speak-tts "text to speak"
# Env: CLAUDE_SPEAK_MAX_CHARS (default 500)

set -euo pipefail

text=${1:-}
[[ -n $text ]] || exit 0

MAX_CHARS=${CLAUDE_SPEAK_MAX_CHARS:-500}
VOICE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/piper/voices"
PIPER_MODEL="$VOICE_DIR/da_DK-talesyntese-medium.onnx"
PIPER_BIN=$(command -v piper-tts || command -v piper || true)
# Serialize playback so rapid mid-turn updates queue instead of talking over
# each other (Filip wants dense, running updates he can follow passively).
LOCK="${XDG_RUNTIME_DIR:-/tmp}/claude-speak-play.lock"
# Barge-in: skip playback if a stop was requested AFTER this line was queued
# (`claude-speak stop` stamps this file, e.g. when Filip starts dictating).
T0=$(date +%s%N)
STOP="${XDG_RUNTIME_DIR:-/tmp}/claude-speak.stopts"

# Drop fenced code blocks + URLs; collapse whitespace
text=$(printf '%s' "$text" | sed '/^```/,/^```/d')
text=$(printf '%s' "$text" | sed -E 's|https?://[^[:space:]]+||g')
text=$(printf '%s' "$text" | tr -d '\000-\010\013\014\016-\037' | tr '\n\r\t' ' ' | sed 's/  */ /g; s/^ //; s/ $//')
[[ -n $text ]] || exit 0

if ((${#text} > MAX_CHARS)); then
	text="${text:0:MAX_CHARS}"
	text="${text% *}…"
fi

play_wav() {
	local wav=$1
	if command -v paplay >/dev/null 2>&1; then
		paplay "$wav" &>/dev/null
	elif command -v aplay >/dev/null 2>&1; then
		aplay -q "$wav" &>/dev/null
	else
		return 1
	fi
}

if [[ -n $PIPER_BIN && -f $PIPER_MODEL ]]; then
	wav=$(mktemp --suffix=.wav)
	if printf '%s' "$text" | "$PIPER_BIN" -m "$PIPER_MODEL" -f "$wav" &>/dev/null; then
		# Synthesis ran in parallel; serialize only playback via flock so queued
		# updates play one after another instead of overlapping.
		(
			flock -w 30 9 || exit 0
			s=$(cat "$STOP" 2>/dev/null || echo 0); [[ ${T0:-0} -lt ${s:-0} ]] && { rm -f "$wav"; exit 0; }
			play_wav "$wav" || true
			rm -f "$wav"
		) 9>"$LOCK" &>/dev/null &
		exit 0
	fi
	rm -f "$wav"
fi

(
	flock -w 30 9 || exit 0
	s=$(cat "$STOP" 2>/dev/null || echo 0); [[ ${T0:-0} -lt ${s:-0} ]] && exit 0
	espeak-ng -v da -s 145 -p 40 "$text" &>/dev/null || true
) 9>"$LOCK" &>/dev/null &
