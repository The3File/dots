#!/usr/bin/env bash
# Fix Waydroid guest routing/DNS after session start.
# Android installs an unreachable catch-all (pref 32000) that blocks
# default routes until main/default tables are preferred.
set -euo pipefail

waydroid status 2>/dev/null | grep -q 'Session:[[:space:]]*RUNNING' || {
	echo "waydroid session is not RUNNING" >&2
	exit 1
}

sudo waydroid shell <<'EOF'
settings put global private_dns_mode off

echo 0 > /proc/sys/net/ipv4/conf/all/arp_ignore
echo 0 > /proc/sys/net/ipv4/conf/eth0/arp_ignore 2>/dev/null || true
echo 0 > /proc/sys/net/ipv4/conf/all/rp_filter
echo 0 > /proc/sys/net/ipv4/conf/eth0/rp_filter 2>/dev/null || true

ip rule del pref 32000 2>/dev/null || true
ip rule add pref 32766 table main 2>/dev/null || true
ip rule add pref 32767 table default 2>/dev/null || true
ip route replace default via 192.168.240.1 dev eth0
EOF

echo "waydroid net fix applied"
