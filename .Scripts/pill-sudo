#!/usr/bin/env bash
# Stil et root-spoergsmaal i pillen.
#
# Blokerende (rejser og venter paa svaret):
#   pill-sudo kode "<kommando>"        -> "ja:<adgangskode>" | "nej"
#
# Raa (til den der selv styrer forloebet — fingeraftrykket):
#   pill-sudo rejs finger|kode "<kommando>"
#   pill-sudo hent                     -> "venter" | "ja" | "nej" | "ingenting"
#   pill-sudo afvist                   -> "ja" hvis der blev sagt nej
#   pill-sudo afbryd
#
# Exit 2 = pillen kunne ikke spoerge (den koerer ikke, eller den staar allerede
# med et ubesvaret spoergsmaal). Kalderen skal saa falde tilbage til zenity --
# et root-spoergsmaal maa aldrig forsvinde bare fordi shellen er nede.
#
# Hvorfor rejsning og svar er to kald og ikke ét: et IPC-kald der ventede paa et
# menneske, ville blokere hele Quickshells traad imens. Derfor rejser vi
# spoergsmaalet, vender tilbage med det samme, og henter svaret indtil der staar
# andet end "venter".

set -uo pipefail

QS=(qs -c ringdal ipc call sudo)
timeout=${PILL_SUDO_TIMEOUT:-120}
tick=0.15

brug() {
	echo "brug: pill-sudo kode <kommando> | rejs finger|kode <kommando> | hent | afvist | afbryd" >&2
	exit 2
}

rejs() { # <slags> <kommando>
	local slags=$1 cmd=$2 raise raised
	case $slags in
	kode) raise=kode ;;
	finger) raise=finger ;;
	*) echo "ukendt: $slags" >&2; return 2 ;;
	esac
	raised=$("${QS[@]}" "$raise" "$cmd" 2>/dev/null) || return 2
	[[ $raised == spurgt ]] || return 2
}

[[ $# -ge 1 ]] || brug

case $1 in
rejs)
	[[ $# -eq 3 ]] || brug
	rejs "$2" "$3"
	exit $?
	;;
hent)
	"${QS[@]}" svar 2>/dev/null || exit 2
	exit 0
	;;
afvist)
	"${QS[@]}" afvist 2>/dev/null || exit 2
	exit 0
	;;
afbryd)
	"${QS[@]}" afbryd >/dev/null 2>&1 || exit 2
	exit 0
	;;
kode)
	[[ $# -eq 2 ]] || brug
	rejs "$1" "$2" || exit 2
	;;
*) brug ;;
esac

deadline=$((SECONDS + timeout))
while ((SECONDS < deadline)); do
	answer=$("${QS[@]}" svar 2>/dev/null) || exit 2
	if [[ $answer != venter ]]; then
		printf '%s\n' "$answer"
		exit 0
	fi
	sleep "$tick"
done

# Han svarede ikke. Ryd spoergsmaalet vaek, saa pillen ikke staar tilbage med
# noget ingen venter paa laengere.
"${QS[@]}" afbryd >/dev/null 2>&1 || true
echo nej
