#!/usr/bin/env bash
# Stil et root-spoergsmaal i pillen.
#
#   pill-sudo rejs "<kommando>"    -> <nummer>        rejser, vender straks tilbage
#   pill-sudo vent <nr>            -> klar|nej|vaek   venter UDEN tidsgraense
#   pill-sudo kode <nr> "<kmd>"    -> ja:<kode>|nej   aabner kodefeltet og venter
#   pill-sudo vagt <nr>            -> venter|nej|slut ét opslag, aldrig en kode
#   pill-sudo afbryd <nr>
#
# Exit 2 = pillen kunne ikke spoerge. Der er INGEN fallback: falder vi tilbage
# til en zenity-dialog, staar root-spoergsmaalet et andet sted end der hvor han
# kigger, og det er vaerre end at kommandoen ikke koerer. Kalderen skal fejle.
#
# Hvorfor rejsning og svar er to kald og ikke ét: et IPC-kald der ventede paa et
# menneske, ville blokere hele Quickshells traad imens. Derfor rejser vi
# spoergsmaalet, vender tilbage med det samme, og henter svaret indtil der staar
# andet end "vent".
#
# `vent` har med vilje ingen deadline. Det er hele pointen: spoergsmaalet skal
# kunne staa til han kommer tilbage til maskinen. Foer laa der 120 sekunder her,
# og saa var svaret "nej", hvis han var ude i koekkenet. Den der kalder, har sin
# egen graense, og den er den rigtige at have.

set -uo pipefail

QS=(qs -c ringdal ipc call sudo)

# `--` før hvert argument, altid. Uden det læser qs et argument, der starter med
# en bindestreg, som sit eget flag: `sudo -n true` blev til "The following
# argument was not expected: -n true", rejsningen fejlede, og gaten meldte at
# pillen ikke kunne spørge om root-adgang. Fejlen så ud som om fladen var nede,
# men den var bare kommandolinjen, der spiste kommandoen.
kode_timeout=${PILL_SUDO_TIMEOUT:-120}
tick=0.15

brug() {
	echo "brug: pill-sudo rejs <kmd> | vent <nr> | kode <nr> <kmd> | vagt <nr> | afbryd <nr>" >&2
	exit 2
}

# Bloker indtil svaret paa <nr> er noget andet end <vente-tilstand>.
# deadline tom = vent for evigt. Exit 3 = tiden loeb ud.
poll() { # <nr> <deadline|""> <vente-tilstand>
	local nr=$1 deadline=$2 vente=$3 svar
	while :; do
		if [[ -n $deadline ]] && ((SECONDS >= deadline)); then
			return 3
		fi
		svar=$("${QS[@]}" svar -- "$nr" 2>/dev/null) || return 2
		if [[ $svar != "$vente" ]]; then
			printf '%s\n' "$svar"
			return 0
		fi
		sleep "$tick"
	done
}

[[ $# -ge 1 ]] || brug

case $1 in
rejs)
	[[ $# -eq 2 ]] || brug
	nr=$("${QS[@]}" rejs -- "$2" 2>/dev/null) || exit 2
	[[ -n $nr ]] || exit 2
	printf '%s\n' "$nr"
	;;
vent)
	[[ $# -eq 2 ]] || brug
	poll "$2" "" vent
	exit $?
	;;
vagt)
	[[ $# -eq 2 ]] || brug
	"${QS[@]}" vagt -- "$2" 2>/dev/null || exit 2
	;;
afbryd)
	[[ $# -eq 2 ]] || brug
	"${QS[@]}" afbryd -- "$2" >/dev/null 2>&1 || exit 2
	;;
kode)
	[[ $# -eq 3 ]] || brug
	raised=$("${QS[@]}" kode -- "$2" "$3" 2>/dev/null) || exit 2
	[[ $raised == spurgt ]] || exit 2
	# Her staar han allerede ved maskinen -- fingeren blev proevet foerst.
	# Derfor er en graense i orden paa koden: et felt der staar for evigt, er
	# bare et felt der er glemt.
	if ! poll "$2" $((SECONDS + kode_timeout)) klar; then
		"${QS[@]}" afbryd -- "$2" >/dev/null 2>&1 || true
		echo nej
	fi
	;;
*) brug ;;
esac
