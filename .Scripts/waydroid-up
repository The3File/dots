#!/usr/bin/env bash
# Start Waydroid session and apply network fix.
set -euo pipefail

sudo modprobe bridge 2>/dev/null || true
sudo systemctl start waydroid-container.service

if ! waydroid status 2>/dev/null | grep -q 'Session:[[:space:]]*RUNNING'; then
	waydroid session start &
	# wait for Android ready / session running
	for _ in $(seq 1 30); do
		if waydroid status 2>/dev/null | grep -q 'Session:[[:space:]]*RUNNING'; then
			break
		fi
		sleep 1
	done
	sleep 3
fi

"$HOME/.Scripts/waydroid-net-fix"

if [[ "${1:-}" == "ui" ]]; then
	exec waydroid show-full-ui
fi
