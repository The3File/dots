#!/usr/bin/env bash
# Run zenity with terminal-like GTK4 CSS: opaque black, Terminus 14, radius 0, wal accent.
# Usage: zenity-rice [zenity args...]
set -euo pipefail

conf_root="${XDG_CONFIG_HOME:-$HOME/.config}/zenity-rice"
mkdir -p "$conf_root/gtk-4.0"

color4="#748A93"
color7="#e2e6e8"
color8="#9ea1a2"
if [[ -f $HOME/.cache/wal/colors.sh ]]; then
	# shellcheck disable=SC1090
	eval "$(grep -E '^color[0-9]+=' "$HOME/.cache/wal/colors.sh")"
fi

bg="#000000"
fg=$color7
accent=$color4
muted=$color8

cat >"$conf_root/gtk-4.0/settings.ini" <<EOF
[Settings]
gtk-font-name=Terminus 14
gtk-decoration-layout=:
EOF

cat >"$conf_root/gtk-4.0/gtk.css" <<EOF
/* Match Alacritty / fuzzel: solid black, Terminus, no rounding, wal accent */
* {
  font-family: Terminus, monospace;
  font-size: 14pt;
  border-radius: 0;
  box-shadow: none;
}

window,
window.background,
dialog,
messagedialog {
  background-color: ${bg};
  color: ${fg};
  border: 2px solid ${accent};
  border-radius: 0;
  padding: 12px;
}

headerbar,
headerbar * {
  background-color: ${bg};
  color: ${fg};
  border: none;
  box-shadow: none;
  min-height: 0;
  padding: 4px 8px;
}

label,
.label {
  color: ${fg};
  background-color: transparent;
}

entry,
textview,
textview > text {
  background-color: ${bg};
  color: ${fg};
  border: 2px solid ${accent};
  border-radius: 0;
  padding: 8px 10px;
  caret-color: ${fg};
}

entry > text selection,
textview > text selection,
selection {
  background-color: ${accent};
  color: ${bg};
}

button {
  background-color: ${bg};
  color: ${fg};
  border: 2px solid ${accent};
  border-radius: 0;
  padding: 6px 16px;
  min-height: 0;
  box-shadow: none;
}

button:hover {
  background-color: ${accent};
  color: ${bg};
}

button:active,
button.suggested-action,
button.default {
  background-color: ${accent};
  color: ${bg};
  border-color: ${accent};
}

button.destructive-action {
  border-color: ${muted};
}

decoration,
windowcontrols,
windowcontrols button {
  background: transparent;
  border: none;
  box-shadow: none;
  color: ${muted};
}
EOF

export XDG_CONFIG_HOME=$conf_root
# Don't inherit a light system theme over our CSS
unset GTK_THEME
exec /usr/bin/zenity "$@"
