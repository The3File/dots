#!/usr/bin/env bash
# Exit 0 only when on battery (safe for hypridle suspend condition_cmd).
# AC / charging / unknown → stay awake.

bat="/sys/class/power_supply/BAT0/status"
ac="/sys/class/power_supply/AC/online"

if [[ -r "$ac" ]]; then
	read -r online < "$ac"
	[[ "$online" == 1 ]] && exit 1
fi

[[ -r "$bat" ]] || exit 1
read -r status < "$bat"
[[ "$status" == Discharging ]]
