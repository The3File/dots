#!/usr/bin/env bash
# ACPI event listener (acpi_listen). Firmware buttons still fire while
# lock_keys has disabled the laptop keyboard / trackpoint / touchpad.
#
# ThinkPad ibm/hotkey 00001317 is the sole lock/unlock toggle for keylock
# (no Super+Shift+K). Unlock still goes through hyprlock auth.
#
# button/power er "jeg er her" til pillens root-spoergsmaal og ellers
# ingenting -- se handleren nedenfor. logind rager ikke ved tasten
# (HandlePowerKey=ignore), saa det her er det eneste sted den betyder noget.
#
# Autostart: hyprland.lua hyprland.start

set -euo pipefail

LOCK_KEYS="${HOME}/.Scripts/lock_keys"
LOCKSCREEN="${HOME}/.Scripts/lockscreen"
RUNTIME="${XDG_RUNTIME_DIR:-/tmp}"
LOCKFILE="${RUNTIME}/acpid_events.lock"

# One instance per user session.
exec 9>"$LOCKFILE"
flock -n 9 || exit 0

# hyprctl needs HIS when not inherited (e.g. odd spawn paths).
if [[ -z ${HYPRLAND_INSTANCE_SIGNATURE:-} && -d ${XDG_RUNTIME_DIR:-/dev/null}/hypr ]]; then
	for d in "${XDG_RUNTIME_DIR}"/hypr/*; do
		[[ -d $d ]] || continue
		export HYPRLAND_INSTANCE_SIGNATURE=${d##*/}
		break
	done
fi

coproc ACPI { acpi_listen; }
trap 'kill "${ACPI_PID}" 2>/dev/null || true' EXIT

handler() {
	case "$1" in
	button/power)
		# Stroemknappen ER fingerlaeseren paa den her maskine, og det er den
		# eneste mening den har: staar der et root-spoergsmaal og venter i
		# pillen, siger trykket "jeg er her" og aabner laeseren -- og fingeren
		# ligger allerede hvor den skal. Trykket giver ingen adgang; det
		# aabner kun vinduet, mens han staar der.
		#
		# Er der ikke noget spoergsmaal, sker der ingenting. Med vilje: knappen
		# aabnede foer en sluk-menu, som han aldrig brugte, og en knap der kan
		# slukke maskinen ved et uheld, er en knap der er i vejen. Sluk-menuen
		# bor i pillen (Super+Alt+Shift+Q).
		#
		# Én knap, én mening -- hvad den betyder, afgoer pillen, praecis som
		# `pill afbryd` paa Super+Escape.
		qs -c ringdal ipc call sudo klar >/dev/null 2>&1 || true
		;;
	ibm/hotkey)
		# ThinkPad firmware hotkey (survives lock_keys): lock + unlock.
		# lock_keys debounce absorbs double firmware events.
		if [[ ${4:-} == 00001317 ]]; then
			"$LOCK_KEYS" toggle
		fi
		;;
	button/prog1 | button/suspend)
		"$LOCKSCREEN" &
		;;
	esac
}

while read -u "${ACPI[0]}" -a event; do
	handler "${event[@]}" &
done
