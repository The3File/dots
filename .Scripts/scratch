#!/usr/bin/env bash

is_wayland() { [[ -n "$WAYLAND_DISPLAY" || "$XDG_SESSION_TYPE" == "wayland" ]]; }

# --- herdr (kun AIOS) --------------------------------------------------------
# AIOS koerer i herdr; scratch-terminalen koerer i tmux (delt 28-08-2026).
# Grunden til delingen: herdr er agent-bevidst og kan noget for AIOS, som tmux
# ikke kan. Den almindelige terminal har ikke brug for det -- der er tmux
# hurtigere at have med at goere, og genvejerne sidder i fingrene.
#
# Begge dele beholder det vigtige: en baggrundsserver, saa det at lukke
# scratch-vinduet aldrig draeber det, der koerer. `herdr --session X` og
# `tmux new-session -A -s X` gaar begge "start eller kobl paa" i ét kald.
#
# NB: prefix er forskellig. tmux: Ctrl+A (hans egen config). herdr: Ctrl+B.
#
# What herdr has no flag for is "start this session running CMD". So the first
# time a session is needed we start its server headless, create the workspace
# ourselves (which gives us a known pane id back) and push the command into that
# root pane.
#
# Efter en genstart er det IKKE nok at tjekke, om serveren koerer. herdr gemmer
# sessionen og genskaber den ved opstart -- men den genskaber kun RUDERNE, ikke
# det der koerte i dem. Filip fik derfor en bar shell-prompt i stedet for Claude,
# og alt saa "doedt" ud. Vi tjekker derfor paa det, der faktisk betyder noget:
# koerer der en agent? Goer der ikke det, sender vi kommandoen ind i den tomme
# rude, serveren allerede har genskabt (i stedet for at lave en rude mere).

# Sandt naar ruden staar tomt ved sin prompt: forgrundsgruppen ER shellen selv.
# Koerer der noget i den, lader vi den vaere -- vi skriver aldrig ind i noget
# der er i gang.
herdr_pane_idle() {
	herdr pane process-info --pane "$1" 2>/dev/null |
		jq -e '.result.process_info
			| .shell_pid != null
			and .foreground_process_group_id == .shell_pid' >/dev/null 2>&1
}

herdr_ensure() {
	local name="$1" dir="$2" cmd="${3:-}"
	export HERDR_SESSION="$name"

	if ! herdr status server 2>/dev/null | grep -q '^status: running'; then
		setsid herdr server >/dev/null 2>&1 </dev/null &

		local i
		for i in $(seq 1 50); do
			herdr status server 2>/dev/null | grep -q '^status: running' && break
			sleep 0.1
		done
	fi

	[[ -z "$cmd" ]] && return

	# Koerer der allerede en agent, er sessionen levende -- roer ingenting.
	local agents
	agents="$(herdr agent list 2>/dev/null | jq -r '.result.agents | length' 2>/dev/null)"
	[[ "${agents:-0}" -gt 0 ]] && return

	# Ingen agent. Find en tom rude (den fokuserede foerst), ellers lav en ny.
	local -a panes=()
	mapfile -t panes < <(herdr pane list 2>/dev/null |
		jq -r '.result.panes | (map(select(.focused)) + .) | .[].pane_id' 2>/dev/null)

	local pane="" p
	for p in "${panes[@]}"; do
		herdr_pane_idle "$p" && { pane="$p"; break; }
	done

	if [[ -n "$pane" ]]; then
		# genbrugt rude: giv arbejdsrummet sit navn tilbage
		local ws="${pane%%:*}"
		herdr workspace rename "$ws" "$name" >/dev/null 2>&1
		herdr workspace focus "$ws" >/dev/null 2>&1
	else
		pane="$(herdr workspace create --cwd "$dir" --label "$name" --focus |
			jq -r '.result.root_pane.pane_id')"
	fi

	[[ -n "$pane" && "$pane" != null ]] &&
		herdr pane run "$pane" "$cmd" >/dev/null
}

# --- Hyprland / Wayland -------------------------------------------------------

hypr_addr() {
	hyprctl clients -j | jq -r --arg c "$cls" '
		.[] | select(.class == $c) | .address' | head -1
}

hypr_toggle() {
	local addr
	addr="$(hypr_addr)"
	if [[ -z "$addr" ]]; then
		# windowrule sends it to special:<class> and shows it
		"$@" &
	else
		# Lua config: legacy `dispatch togglespecialworkspace` is invalid;
		# use hl.dsp.workspace.toggle_special instead.
		hyprctl eval "hl.dispatch(hl.dsp.workspace.toggle_special(\"$cls\"))"
	fi
}

hypr_aios() {
	cls="scratchaios"
	herdr_ensure 'AIOS' "${HOME}/AIOS" "${HOME}/AIOS/aios"
	hypr_toggle $TERMINAL --class $cls,$cls -e herdr --session 'AIOS'
}

hypr_term() {
	cls="scratchterm"
	hypr_toggle $TERMINAL --class $cls,$cls -e tmux new-session -A -s scratch -c "$HOME"
}

# --- bspwm / X11 (original) ---------------------------------------------------

get_id(){ id="$(xdotool search --class $cls)"; }
toggle(){ bspc node "$id" --flag hidden -f; exit; }

aios(){
	is_wayland && { hypr_aios; return; }

	cls="scratchaios"; get_id
	[[ -z "$id" ]] || toggle

	herdr_ensure 'AIOS' "${HOME}/AIOS" "${HOME}/AIOS/aios"
	$TERMINAL --class $cls,$cls -e herdr --session 'AIOS'
}

term(){
	is_wayland && { hypr_term; return; }

	cls="scratchterm"; get_id
	[[ -z "$id" ]] || toggle

	$TERMINAL --class $cls,$cls -e tmux new-session -A -s scratch -c "$HOME"
}

eval $1
