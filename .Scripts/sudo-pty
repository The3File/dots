#!/usr/bin/env python3
"""Authenticate on a real PTY, then run the command with that ticket.

Two steps on purpose. `sudo -v` does nothing but authenticate, and the instant
it succeeds the shell prints a marker. That marker is the only way to know the
finger was accepted *before* the command starts producing output — which is
what lets the pill confirm it on screen instead of leaving Filip guessing
whether anything happened.

The marker is an OSC escape sequence, not a word: if it ever slips past the
filter it is invisible in a terminal rather than looking like output.

A real PTY is required, not optional: /etc/pam.d/sudo only offers the
fingerprint when the tty looks like /dev/pts/*. And it has to be pty.spawn
rather than pty.fork, because spawn also forwards stdin — `echo x | sudo tee f`
has to keep working.

Both sudo calls run inside the same PTY, so the second one finds the ticket the
first one made (sudo scopes tickets per tty by default).
"""

from __future__ import annotations

import os
import pty
import shutil
import subprocess
import sys

MARKER = b"\x1b]777;sudo-ok\x07"

# -K first, as its own call: it throws the old ticket away without asking for
# anything, so every run really does require a fresh finger. It cannot be folded
# into the -v call as `-k -v` — that combination deliberately refuses to save the
# ticket it just earned, and then the second sudo has nothing to work with
# ("a password is required", after the finger was accepted).
SCRIPT = (
    'sudo -K 2>/dev/null; sudo -A -v'
    ' && printf "\\033]777;sudo-ok\\007"'
    ' && shift && exec sudo -n -- "$@"'
)


def main() -> int:
    argv = sys.argv[1:]
    if not argv:
        print("sudo-pty: command required", file=sys.stderr)
        return 1

    told = False
    # The marker can be split across two reads, so keep just enough of the tail
    # to recognise it when the rest arrives.
    carry = b""
    qs = shutil.which("qs") if os.environ.get("SUDO_PILL") == "1" else None

    def kvitter() -> None:
        # Fire and forget: the pill saying "godkendt" must never be able to
        # hold up the command it is confirming.
        subprocess.Popen(
            [qs, "-c", "ringdal", "ipc", "call", "sudo", "godkendt"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )

    def filtrer(fd: int) -> bytes:
        nonlocal told, carry
        data = os.read(fd, 4096)
        if not data:
            return data
        if told:
            return data
        buf = carry + data
        i = buf.find(MARKER)
        if i < 0:
            keep = len(MARKER) - 1
            carry = buf[-keep:] if keep else b""
            return buf[: len(buf) - len(carry)]
        told = True
        if qs:
            kvitter()
        carry = b""
        return buf[:i] + buf[i + len(MARKER) :]

    # $0 is a label, $1 is a placeholder the script shifts away, then "$@" is
    # the real argv. Passing it this way means nothing is ever re-parsed by a
    # shell: the command runs as the exact argv that was shown on screen.
    cmd = ["/bin/bash", "-c", SCRIPT, "sudo-pty", "-", *argv]
    return os.waitstatus_to_exitcode(pty.spawn(cmd, filtrer))


if __name__ == "__main__":
    raise SystemExit(main())
